{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python",
      "config": {
        "excludeFiles": "**/{onnxruntime,chromadb,lancedb,lance_namespace,lance_namespace_urllib3_client,huggingface_hub,tokenizers,kubernetes,pyarrow,hf_xet,pdfminer,pdfplumber,pypdfium2,fitz,grpcio}/**"
      }
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ]
}
